# Sunucu yalnızca bu bilgisayardan erişilebilir. Ağ erişimini bilinçli açmadıkça değiştirmeyin.
HOST=127.0.0.1
PORT=4173

# İsteğe bağlı Responses-uyumlu AI servisi. URL ve model boşsa yerel kurallar kullanılır.
AI_API_URL=
# Yalnızca 127.0.0.1, localhost veya ::1 üzerindeki yerel servislerde boş bırakılabilir.
AI_API_KEY=
AI_MODEL=

# Varsayılan true: e-posta ve telefon ifadeleri AI çağrısından önce maskelenir.
AI_REDACT=true

# İsteğe bağlı özel veri dizini. Boşsa ./data kullanılır.
DATA_DIR=
